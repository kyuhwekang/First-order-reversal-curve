%% FORC_voltage_source_generator.m
% Generate a normalized voltage-time source file for
% first-order reversal curve (FORC) measurements.
%
% The waveform consists of:
%
%   1. An initial hold at V_base.
%   2. A sequence of triangular FORC waveforms with progressively
%      increasing reversal voltages.
%   3. Optionally, a full repoling sweep before each FORC waveform.
%   4. A final hold at V_base.
%
% The reversal voltage for FORC unit l is
%
%   V_peak(l) = V_base + l*Dalpha
%
% where l = 1, 2, ..., N_units.
%
% N_units is determined automatically from V_base, V_max, and Dalpha.
%
% Example:
%
%   V_base = -100 V
%   V_max  = +100 V
%   Dalpha = 2 V
%
% gives
%
%   V_peak = -98, -96, -94, ..., +98, +100 V
%
% When repoling_full_sweep = false:
%
%   V_base --> V_peak --> V_base
%
% When repoling_full_sweep = true:
%
%   V_base --> V_max  --> V_base
%   V_base --> V_peak --> V_base
%
% Saved text-file format:
%
%   Row 1       = number of waveform data points
%   Row 2       = sampling rate [points/s]
%   Row 3:end   = normalized voltage V/V_max


%% ======================= USER PARAMETERS =============================

frequency = 100;      % Waveform frequency [Hz]

polT      = 1;     % Initial hold duration at V_base [s]
endT      = 0.1;      % Final hold duration at V_base [s]

Dppc      = 1000;       % Data points per triangle/cycle; must be even

V_base    = -100;     % Baseline voltage [V]
V_max     = 100;      % Maximum voltage [V]

Dalpha    = 2;        % Reversal-voltage increment [V]

% Repoling mode:
%
% false:
%   V_base --> V_peak --> V_base
%
% true:
%   V_base --> V_max  --> V_base
%   V_base --> V_peak --> V_base
%
repoling_full_sweep = false;


%% ======================= INPUT CHECKS ================================

if frequency <= 0
    error('frequency must be greater than zero.');
end

if Dppc <= 0 || mod(Dppc,1) ~= 0
    error('Dppc must be a positive integer.');
end

if mod(Dppc,2) ~= 0
    error(['Dppc must be even so that the rising and falling ', ...
           'parts of each triangle contain equal numbers of points.']);
end

if V_max <= V_base
    error('V_max must be greater than V_base.');
end

if V_max <= 0
    error('V_max must be greater than zero for V/V_max normalization.');
end

if abs(V_base) > V_max
    error(['abs(V_base) cannot exceed V_max because the saved ', ...
           'waveform is normalized by V_max.']);
end

if Dalpha <= 0
    error('Dalpha must be greater than zero.');
end

if polT < 0
    warning('polT < 0 was provided. Using polT = 0.');
    polT = 0;
end

if endT < 0
    warning('endT < 0 was provided. Using endT = 0.');
    endT = 0;
end


%% ======================= REVERSAL VOLTAGES ===========================

% Total voltage range covered by the FORC sequence
V_range = V_max - V_base;

% Number of reversal-voltage increments required
N_units_exact = V_range / Dalpha;

% Require the voltage range to be an integer multiple of Dalpha.
%
% For example:
%
%   V_base = -100
%   V_max  =  100
%   Dalpha =    2
%
% gives N_units = 100 exactly.

if abs(N_units_exact - round(N_units_exact)) > 1e-10
    error([ ...
        '(V_max - V_base) must be an integer multiple of Dalpha.\n', ...
        'Current values give %.10g increments.'], ...
        N_units_exact);
end

N_units = round(N_units_exact);

% Reversal voltages:
%
% V_base + Dalpha,
% V_base + 2*Dalpha,
% ...
% V_max

V_peak_all = V_base + (1:N_units)*Dalpha;


%% ======================= DERIVED PARAMETERS ==========================

% Sampling rate
points_per_sec = frequency * Dppc;      % [points/s]

% Number of points in the initial baseline hold
n_poll = round(polT * points_per_sec) + 1;

% Number of points in final baseline hold
n_end = round(endT * points_per_sec);

% Number of points in half of one triangle
n_half = Dppc / 2;


%% ======================= INITIAL HOLD ================================

V = V_base * ones(n_poll,1);


%% ======================= TRIANGLE GENERATOR ==========================

% Create one triangle:
%
% V_start --> V_peak --> V_end
%
% Total number of points = Dppc.
%
% The construction below follows the original waveform-generation method.

build_triangle = @(V_start,V_peak,V_end) [ ...
    linspace(V_start, V_peak, n_half)'; ...
    linspace(V_peak,  V_end,  n_half)' ...
    ];


%% ======================= GENERATE FORC WAVEFORM ======================

for l = 1:N_units

    % Reversal voltage for the current FORC unit
    V_peak = V_peak_all(l);


    if repoling_full_sweep

        % -------------------------------------------------------------
        % Full repoling triangle
        %
        % V_base --> V_max --> V_base
        % -------------------------------------------------------------

        tri_full = build_triangle( ...
            V_base, ...
            V_max, ...
            V_base);


        % -------------------------------------------------------------
        % Peak-limited FORC triangle
        %
        % V_base --> V_peak --> V_base
        % -------------------------------------------------------------

        tri_peak = build_triangle( ...
            V_base, ...
            V_peak, ...
            V_base);


        % Append both triangles
        V = [V; tri_full; tri_peak];


    else

        % -------------------------------------------------------------
        % Peak-limited FORC triangle only
        %
        % V_base --> V_peak --> V_base
        % -------------------------------------------------------------

        tri_peak = build_triangle( ...
            V_base, ...
            V_peak, ...
            V_base);

        V = [V; tri_peak];

    end

end


%% ======================= FINAL HOLD ==================================

if n_end > 0
    V = [V; V_base * ones(n_end,1)];
end


%% ======================= PREPARE OUTPUT ==============================

num_points = length(V);

% Normalize voltage by V_max.
%
% Example for V_max = 100 V:
%
%   +100 V --> +1
%      0 V -->  0
%   -100 V --> -1
%
V_normalized = V / V_max;


% Output structure:
%
% Row 1       = number of waveform points
% Row 2       = sampling rate [points/s]
% Row 3:end   = normalized voltage

save_data = [ ...
    num_points; ...
    points_per_sec; ...
    V_normalized ...
    ];


%% ======================= SAVE FILE ==================================

[filename, pathname] = uiputfile( ...
    '*.txt', ...
    'Save FORC Voltage Source File');


if isequal(filename,0) || isequal(pathname,0)

    disp('User canceled file save.');

else

    fullpath = fullfile(pathname, filename);

    writematrix( ...
        save_data, ...
        fullpath, ...
        'Delimiter', 'tab');

    fprintf('\nFORC voltage source file saved to:\n%s\n', fullpath);

end


%% ======================= DISPLAY INFORMATION =========================

fprintf('\n');
fprintf('================ FORC WAVEFORM =================\n');
fprintf('Baseline voltage           : %.6g V\n', V_base);
fprintf('Maximum voltage            : %.6g V\n', V_max);
fprintf('Reversal increment         : %.6g V\n', Dalpha);
fprintf('Number of FORC units       : %d\n', N_units);
fprintf('First reversal voltage     : %.6g V\n', V_peak_all(1));
fprintf('Last reversal voltage      : %.6g V\n', V_peak_all(end));
fprintf('Data points per triangle   : %d\n', Dppc);
fprintf('Sampling rate              : %.6g points/s\n', points_per_sec);
fprintf('Total waveform data points : %d\n', num_points);

if repoling_full_sweep
    fprintf('Repoling mode              : Full sweep + FORC sweep\n');
else
    fprintf('Repoling mode              : FORC sweep only\n');
end

fprintf('================================================\n');


%% ======================= PLOT WAVEFORM ===============================

time = (0:num_points-1)' / points_per_sec;


figure;

plot(time, V, 'LineWidth', 1.2);

xlabel('Time (s)');
ylabel('Voltage (V)');

if repoling_full_sweep
    title('FORC Voltage: Full Repoling Sweep + Reversal Sweep');
else
    title('FORC Voltage: Reversal Sweep Only');
end

grid on;
box on;
